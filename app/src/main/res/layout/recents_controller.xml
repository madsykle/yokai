<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recents_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The whole body: Cupertino chrome (large title, search, segmented control) plus the
         LazyColumn, with the empty and loading states overlaid inside the same composition.

         This replaces the RecyclerView / SwipeRefreshLayout / FrameLayout / EmptyView /
         LoadingIndicator tree. It stayed a ComposeView declared here rather than becoming a
         Compose base class because RecentsController still holds a ViewBinding that the download
         bottom sheet alone accounts for; keeping `binding.root` keeps the sheet, the
         BottomSheetBehavior's child ordering and the controller lifecycle exactly as they were. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cupertino_chrome"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Adding bottom sheet after main content. Must stay LAST: BottomSheetBehavior draws the
         sheet above everything else in this CoordinatorLayout. -->
    <include layout="@layout/download_bottom_sheet"
        android:id="@+id/download_bottom_sheet"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>