<?xml version="1.0" encoding="utf-8"?>
<eu.kanade.tachiyomi.ui.library.filter.FilterTagGroup xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="34dp"
    android:layout_margin="5dp"
    android:background="@android:color/transparent"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/firstButton"
        style="@style/Widget.Tachiyomi.FilterTag"
        tools:text="Item 1" />

    <View
        android:id="@+id/separator1"
        android:layout_width="1dp"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:background="@android:color/transparent" />

    <TextView
        android:id="@+id/secondButton"
        style="@style/Widget.Tachiyomi.FilterTag"
        tools:text="Item 2" />

    <View
        android:id="@+id/separator2"
        android:layout_width="1dp"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:background="@android:color/transparent" />

    <TextView
        android:id="@+id/thirdButton"
        style="@style/Widget.Tachiyomi.FilterTag"
        tools:text="Item 3" />

    <View
        android:id="@+id/separator3"
        android:layout_width="1dp"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:background="@android:color/transparent" />

    <TextView
        android:id="@+id/fourthButton"
        style="@style/Widget.Tachiyomi.FilterTag"
        tools:text="Item 4" />

    <View
        android:id="@+id/separator4"
        android:layout_width="1dp"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:background="@android:color/transparent" />

    <TextView
        android:id="@+id/fifthButton"
        style="@style/Widget.Tachiyomi.FilterTag"
        tools:text="Item 5" />
</eu.kanade.tachiyomi.ui.library.filter.FilterTagGroup>
