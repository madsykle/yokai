<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--== iOS dark palette for the default night theme ==-->
    <style name="Theme.Base.Night" parent="Theme.Base">
        <item name="background">@color/ios_black</item>
        <item name="android:colorBackground">@color/ios_black</item>

        <item name="colorSurface">@color/ios_black</item>
        <item name="colorSurfaceContainerLowest">@color/ios_black</item>
        <item name="colorSurfaceContainerLow">@color/ios_grouped</item>
        <item name="colorSurfaceContainer">@color/ios_grouped</item>
        <item name="colorSurfaceContainerHigh">@color/ios_raised</item>
        <item name="colorSurfaceContainerHighest">@color/ios_raised</item>

        <item name="colorOnSurface">@color/ios_label</item>
        <item name="colorOnBackground">@color/ios_label</item>
        <item name="colorOnSurfaceVariant">@color/ios_label_secondary</item>

        <item name="colorOutline">@color/ios_separator</item>
        <item name="colorOutlineVariant">@color/ios_raised</item>

        <item name="colorPrimary">@color/ios_blue</item>
