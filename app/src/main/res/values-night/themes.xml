        <item name="colorSecondaryContainer">@color/ios_raised</item>
        <item name="colorOnSecondaryContainer">@color/ios_label</item>

        <item name="colorError">@color/ios_red</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Yokai.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Yokai.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Yokai.DisplaySmall</item>
