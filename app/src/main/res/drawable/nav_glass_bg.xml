<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>

    <item
        android:bottom="8dp"
        android:left="16dp"
        android:right="16dp"
        android:top="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:angle="270"
                android:endColor="#0AFFFFFF"
                android:startColor="#40FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:bottom="9dp"
        android:left="17dp"
        android:right="17dp"
        android:top="9dp">
        <shape android:shape="rectangle">
            <corners android:radius="31dp" />
            <solid android:color="#1C1C1E" />
        </shape>
    </item>
</layer-list>
