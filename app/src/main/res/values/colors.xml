    <!-- Bottom Nav Glass Selectors (Light) -->
    <color name="bottom_nav_item_selected">@color/accent_blue</color>
    <color name="bottom_nav_item_unselected">@color/label_secondary_light</color>
    <color name="bottom_nav_text_selected">@color/accent_blue</color>
    <color name="bottom_nav_text_unselected">@color/label_secondary_light</color>
    <!-- Lighter concentric pill on the selected tab; the bar behind it is the
         frosted capsule, so the highlight has to read as "one layer up". -->
    <color name="bottom_nav_active_indicator">#59FFFFFF</color>

    <drawable name="bottom_nav_item_selector">
        <selector>
            <item android:color="@color/bottom_nav_item_selected" android:state_selected="true" />
            <item android:color="@color/bottom_nav_item_unselected" />
        </selector>
    </drawable>

    <drawable name="bottom_nav_text_selector">
        <selector>
            <item android:color="@color/bottom_nav_text_selected" android:state_selected="true" />
            <item android:color="@color/bottom_nav_text_unselected" />
        </selector>
    </drawable>
